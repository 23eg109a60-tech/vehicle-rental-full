# Example only. Set these as operating-system environment variables or in Render.
DATABASE_PLATFORM=postgresql
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vehicle_rental
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-your-own-password
